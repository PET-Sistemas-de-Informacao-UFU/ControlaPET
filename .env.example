# ==========================================
# Variáveis de Banco de Dados (Supabase)
# ==========================================
# Cole a URL do Transaction Pooler aqui e NÃO ESQUEÇA do ?prepareThreshold=0
DB_URL_CONTROLAPET=

# Seu usuário do Supabase
DB_USER_CONTROLAPET=

# A sua senha real do banco de dados
DB_PASSWORD_CONTROLAPET=

# ==========================================
# JWT
# ==========================================
# Chave de assinatura dos tokens (base64, 512 bits)
JWT_SECRET_CONTROLAPET=
