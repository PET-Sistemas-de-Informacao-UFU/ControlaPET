# Backend: omita as variaveis de banco para usar o PostgreSQL local do docker-compose.
# DB_URL_CONTROLAPET=jdbc:postgresql://localhost:5432/inventario_pet
# DB_USER_CONTROLAPET=postgres
# DB_PASSWORD_CONTROLAPET=postgres

# Backend: chave JWT (obrigatoria em producao; gere uma chave propria).
# JWT_SECRET_CONTROLAPET=

# Backend: endereco do frontend e envio de e-mail.
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=

# Backend: configuracoes opcionais.
# PORT=8080
# LOG_FILE=logs/controlapet.log
# JWT_EXPIRATION_CONTROLAPET=900000
# JWT_REFRESH_EXPIRATION_CONTROLAPET=604800000
# PASSWORD_RESET_EMAIL_MAX=3
# PASSWORD_RESET_IP_MAX=10
# PASSWORD_RESET_WINDOW_MINUTES=15

# Frontend: URL publica; variaveis VITE_ ficam visiveis no navegador.
# Para front e API no mesmo dominio, use VITE_API_URL=/api.
VITE_API_URL=http://localhost:8080/api

# Primeira instalacao: habilite apenas em banco vazio e desative apos criar o admin.
# O administrador recebe por e-mail um link para definir a senha.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=

# Docker de producao: banco interno controlapet; informe DB_USER_CONTROLAPET e
# DB_PASSWORD_CONTROLAPET acima. DB_URL_CONTROLAPET e definida pelo Compose.
# Use FRONTEND_URL e CORS_ALLOWED_ORIGINS com o dominio HTTPS definitivo.
# O frontend Docker usa /api; VITE_API_URL acima vale para execucao fora dele.
# WEB_BIND_ADDRESS=127.0.0.1
# WEB_PORT=8080
